generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AttendanceRecord {
  id        String   @id
  lessonId  String
  studentId String
  status    String
  note      String?
  markedAt  DateTime @default(now())
  User      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model CoinTransaction {
  id         String   @id
  studentId  String
  amount     Int
  reason     String
  sourceType String
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  // Leaderboard week/month filter scans by date across all students.
  @@index([createdAt])
}

model Direction {
  id    String  @id
  name  String  @unique
  color String
  Group Group[]
}

model Enrollment {
  id        String   @id
  studentId String
  groupId   String
  status    String   @default("ACTIVE")
  joinedAt  DateTime @default(now())
  Group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, groupId])
  @@index([groupId])
}

model Group {
  id           String       @id
  name         String
  courseName   String       @default("")
  directionId  String
  teacherId    String
  status       String       @default("ACTIVE")
  maxStudents  Int          @default(20)
  scheduleDays String       @default("")
  scheduleTime String       @default("")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  Enrollment   Enrollment[]
  Teacher      Teacher      @relation(fields: [teacherId], references: [id])
  Direction    Direction    @relation(fields: [directionId], references: [id])
  Lesson       Lesson[]
  Mission      Mission[]
  Quiz         Quiz[]

  @@index([teacherId])
  @@index([directionId])
}

model Homework {
  id          String       @id
  lessonId    String       @unique
  title       String
  description String?
  deadline    DateTime
  maxScore    Int          @default(100)
  status      String       @default("ACTIVE")
  /// Telegram "deadline in 2 hours" reminder already sent to non-submitters.
  reminderSentAt DateTime?
  Lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  Submission  Submission[]

  @@index([reminderSentAt, deadline])
}

model Lesson {
  id               String             @id
  groupId          String
  lessonOrder      Int
  lessonDate       DateTime
  topic            String
  description      String?
  status           String             @default("PLANNED")
  AttendanceRecord AttendanceRecord[]
  Homework         Homework?
  Group            Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, lessonOrder])
  @@index([lessonDate])
}

model Notification {
  id        String   @id
  userId    String
  type      String
  title     String
  message   String
  relatedId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Payment {
  id                String    @id
  studentId         String
  amount            Int
  orderNumber       Int       @default(1)
  amountNumber      Int       @default(0)
  status            String    @default("PENDING")
  paymentType       String
  description       String?
  teacherName       String    @default("")
  receiptNumber     String?
  paidAt            DateTime?
  dueDate           DateTime
  /// True when a teacher set a real due date (older rows store createdAt there).
  hasDueDate        Boolean   @default(false)
  /// Telegram "pays tomorrow" reminder / "overdue" notice already sent.
  reminderSentAt    DateTime?
  overdueNotifiedAt DateTime?
  createdAt         DateTime  @default(now())
  User              User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([status, hasDueDate, dueDate])
}

model Product {
  id            String         @id
  name          String
  description   String?
  price         Int
  originalPrice Int?
  category      String
  image         String         @default("")
  rating        Float          @default(0)
  reviews       Int            @default(0)
  imageUrl      String?
  isPopular     Boolean        @default(false)
  isNew         Boolean        @default(false)
  isLimited     Boolean        @default(false)
  isActive      Boolean        @default(true)
  stock         Int?
  createdAt     DateTime       @default(now())
  Purchase      Purchase[]
  WishlistItem  WishlistItem[]
}

model Purchase {
  id        String   @id
  studentId String
  productId String
  price     Int
  createdAt DateTime @default(now())
  Product   Product  @relation(fields: [productId], references: [id])
  User      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

model RefreshToken {
  id          String    @id
  tokenHash   String    @unique
  userId      String
  expiresAt   DateTime
  revokedAt   DateTime?
  /// Issued through the Telegram Mini App (students may only use these when Telegram-only is on).
  viaTelegram Boolean   @default(false)
  createdAt   DateTime  @default(now())
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Submission {
  id            String    @id
  homeworkId    String
  studentId     String
  content       String
  attachmentUrl String?
  status        String    @default("SUBMITTED")
  score         Int?
  feedback      String?
  submittedAt   DateTime  @default(now())
  gradedAt      DateTime?
  User          User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Homework      Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([status])
  // Daily missions: "submitted today" / "graded today" per student.
  @@index([studentId, submittedAt])
  @@index([studentId, gradedAt])
}

model Teacher {
  id       String  @id
  fullName String
  avatar   String?
  userId   String? @unique
  Group    Group[]
}

model User {
  id                String              @id
  email             String              @unique
  passwordHash      String
  firstName         String
  lastName          String
  phone             String?
  avatar            String?
  role              String              @default("STUDENT")
  status            String              @default("ACTIVE")
  coinBalance       Int                 @default(0)
  /// Telegram user id of the student's linked account (Mini App login).
  telegramId        String?             @unique
  telegramUsername  String?
  /// sha256 of the one-time code a teacher gives the student to link Telegram.
  linkCodeHash      String?             @unique
  linkCodeExpiresAt DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  AttendanceRecord  AttendanceRecord[]
  CoinTransaction   CoinTransaction[]
  Enrollment        Enrollment[]
  Notification      Notification[]
  Payment           Payment[]
  Purchase          Purchase[]
  RefreshToken      RefreshToken[]
  Submission        Submission[]
  WishlistItem      WishlistItem[]
  MissionCompletion MissionCompletion[]
  DailyChest        DailyChest[]
  AvatarPurchase    AvatarPurchase[]
  QuizAttempt       QuizAttempt[]
  ChatMessage       ChatMessage[]
}

model WishlistItem {
  id        String   @id
  studentId String
  productId String
  createdAt DateTime @default(now())
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, productId])
}

// Daily missions are created by staff and verified by the server — a student
// can only claim one whose condition (see `type`) is met today (Asia/Tashkent).
model Mission {
  id                String              @id
  title             String
  description       String?
  emoji             String              @default("⭐")
  // SUBMIT_HOMEWORK | ATTEND_LESSON | GOOD_GRADE | PASS_QUIZ
  type              String
  // GOOD_GRADE / PASS_QUIZ: minimum score percentage (0-100); unused by other types
  target            Int?
  // PASS_QUIZ only: the test the student has to pass
  quizId            String?
  coinReward        Int
  // null = every student; otherwise only students enrolled in this group
  groupId           String?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  Group             Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // SetNull: deleting a test keeps the mission's claim history (coins, streak days);
  // a PASS_QUIZ mission without a test is simply hidden from students.
  Quiz              Quiz?               @relation(fields: [quizId], references: [id], onDelete: SetNull)
  MissionCompletion MissionCompletion[]

  @@index([isActive])
}

model MissionCompletion {
  id        String   @id
  missionId String
  studentId String
  // Asia/Tashkent calendar day, "YYYY-MM-DD"
  day       String
  coins     Int
  createdAt DateTime @default(now())
  Mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([missionId, studentId, day])
  @@index([studentId, day])
}

model DailyChest {
  id        String   @id
  studentId String
  // Asia/Tashkent calendar day, "YYYY-MM-DD"
  day       String
  reward    Int
  createdAt DateTime @default(now())
  User      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, day])
}

// Paid character-editor items (hair, outfit, hat…) a student bought with coins.
// Prices live in src/modules/avatar/avatar.catalog.ts, never in the client.
model AvatarPurchase {
  id        String   @id
  studentId String
  itemKey   String
  price     Int
  createdAt DateTime @default(now())
  User      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, itemKey])
}

// Teacher-made multiple-choice test. Correct answers never leave the server.
model Quiz {
  id           String         @id
  title        String
  description  String?
  // null = every student; otherwise only students enrolled in this group
  groupId      String?
  // null = no time limit
  timeLimitMin Int?
  // Coins a student gets for finishing with at least passPercent % (0 = no coins)
  coinReward   Int            @default(0)
  passPercent  Int            @default(60)
  isActive     Boolean        @default(true)
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  Group        Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  QuizQuestion QuizQuestion[]
  QuizAttempt  QuizAttempt[]
  Mission      Mission[]

  @@index([isActive])
}

model QuizQuestion {
  id           String   @id
  quizId       String
  order        Int
  text         String
  options      String[]
  correctIndex Int
  Quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
}

// One attempt per student per test; score is set when it's finished.
model QuizAttempt {
  id         String    @id
  quizId     String
  studentId  String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  score      Int?
  total      Int
  // { [questionId]: chosen original option index }
  answers    Json?
  // Coins paid out when this attempt finished (0 = below passPercent / no reward)
  coins      Int       @default(0)
  Quiz       Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  User       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@index([studentId, finishedAt])
}

/// Teacher ↔ family chat through the Telegram bot. One thread per student:
/// whoever uses the student's linked Telegram (the student or a parent) writes
/// to the bot; staff answer from the teacher panel and the bot delivers it.
model ChatMessage {
  id          String   @id
  studentId   String
  /// true = came in from the bot (family); false = sent by staff from the panel.
  fromStudent Boolean
  /// Staff sender's name at the time of sending (outgoing messages only).
  senderName  String?
  /// text | photo | voice | video_note | video
  kind        String   @default("text")
  /// Message text, or the caption of a media message (may be empty).
  text        String
  /// Media lives on Telegram's servers (Telegram is the file storage): only
  /// its file_id is kept here; the server fetches the file when it's viewed.
  fileId      String?
  /// Seconds, for voice / video messages.
  duration    Int?
  /// Copy in the private Telegram archive channel (TELEGRAM_ARCHIVE_CHAT_ID):
  /// keeps the file alive even if the family deletes their chat, and gives
  /// staff a readable log. archivedAt is set once handled (copied, or given
  /// up on); unset rows are picked up by the archiver.
  archiveMessageId Int?
  archiveFileId    String?
  archivedAt       DateTime?
  /// Incoming messages: seen by staff in the panel.
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  Student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([fromStudent, isRead])
  @@index([archivedAt, createdAt])
}
