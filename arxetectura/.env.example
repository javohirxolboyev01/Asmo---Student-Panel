DATABASE_URL="postgresql://user:password@localhost:5432/asmo?schema=public"
PORT=4000
JWT_SECRET="replace-with-a-long-random-secret-at-least-16-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30
CORS_ORIGIN="http://localhost:3000"

# Telegram Mini App for students (optional). With a token set, students can
# only open the app from the bot; teachers/admins keep the browser login.
# TELEGRAM_BOT_TOKEN="123456:ABC..."      # from @BotFather
# PUBLIC_APP_URL="https://your-app.up.railway.app"  # Railway: auto from RAILWAY_PUBLIC_DOMAIN
# TELEGRAM_STUDENT_ONLY=0                  # 0 = also allow student browser login
# TELEGRAM_ARCHIVE_CHAT_ID=-1001234567890  # private channel (bot = admin): archive of all chat messages/files
# TELEGRAM_POLLING=1                       # local dev only, with a separate test bot
